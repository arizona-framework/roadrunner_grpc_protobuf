%% Logger config for the test profile. Disables the default console
%% handler so deliberately triggered crash paths (a TestService method
%% that fails, a call cancelled past its deadline) don't print crash
%% reports into the test log. Real failures still surface through eunit's
%% and Common Test's own reporting.
[
    {kernel, [
        {logger_level, critical},
        {logger, [{handler, default, undefined}]}
    ]}
].
