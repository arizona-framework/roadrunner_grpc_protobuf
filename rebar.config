{minimum_otp_vsn, "27"}.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_missing_spec,
    warn_export_vars,
    warn_unused_import,
    warn_obsolete_guard
]}.

%% gpb is not a dependency: the modules it generates run on their own, so
%% only the tests need it, to generate gRPC's interop protos. Roadrunner's
%% gRPC is on its main branch, not yet in a Hex release.
{deps, [
    {roadrunner, {git, "https://github.com/arizona-framework/roadrunner.git", {branch, "main"}}}
]}.

{project_plugins, [
    {erlfmt, "1.8.0"},
    {rebar3_hank, "2.0.2"},
    {rebar3_hex, "7.5.0"},
    {rebar3_ex_doc, "0.3.0"}
]}.

{erlfmt, [
    write,
    {files, [
        "rebar.config",
        "src/*.{erl,hrl,app.src}",
        "test/*.{erl,hrl}"
    ]}
]}.

{profiles, [
    {test, [
        {erl_opts, [nowarn_export_all, nowarn_missing_spec]},
        {extra_src_dirs, [{"test", [{recursive, true}]}]},
        %% Compiles `test/proto` (gRPC's interop protos) to `test/gen`
        %% (git-ignored) before the build, which then compiles them with the
        %% tests. The plugin writes under the app's `_build` dir, whose `src`
        %% links back to the project's: `src/..` is the project root. Type
        %% specs are off, as gpb 5.0.0 wraps a long map-field comment onto a
        %% line of its own in them, which does not compile.
        {plugins, [{rebar3_gpb_plugin, "3.0.1"}]},
        {gpb_opts, [
            {i, "test/proto"},
            {o_erl, "src/../test/gen"},
            {o_hrl, "src/../test/gen"},
            {module_name_suffix, "_pb"},
            maps,
            use_packages,
            strings_as_binaries,
            {type_specs, false},
            %% The `.proto` files described, for server reflection.
            descriptor
        ]},
        {provider_hooks, [{pre, [{compile, {protobuf, compile}}]}]},
        {deps, [
            %% The Protocol Buffers compiler behind the tests' generated
            %% modules, and its descriptor decoder for the reflection tests.
            {gpb, "5.0.0"}
        ]}
    ]}
]}.

{cover_enabled, true}.
{cover_export_enabled, true}.

{eunit_opts, [{sys_config, ["config/test.config"]}]}.
{ct_opts, [{sys_config, ["config/test.config"]}]}.

{dialyzer, [
    {warnings, [unknown, unmatched_returns, error_handling]},
    {plt_apps, top_level_deps}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{hank, [
    {ignore, [
        %% gpb's generated modules.
        "test/gen/*.erl",
        %% The gRPC methods, whose arity the service behaviour fixes.
        {"test/roadrunner_grpc_protobuf_tests.erl", unnecessary_function_arguments},
        {"test/roadrunner_grpc_protobuf_interop.erl", unnecessary_function_arguments}
    ]}
]}.

{ex_doc, [
    {extras, [
        "README.md",
        "CHANGELOG.md",
        "LICENSE.md"
    ]},
    {main, "README.md"},
    {api_reference, true},
    {source_url, "https://github.com/arizona-framework/roadrunner_grpc_protobuf"},
    {prefix_ref_vsn_with_v, false}
]}.

{hex, [{doc, #{provider => ex_doc}}]}.

{alias, [
    {doc, [ex_doc]},
    {precommit, [
        {fmt, "--check"},
        compile,
        xref,
        hank,
        dialyzer,
        ex_doc,
        {eunit, "--cover"},
        {ct, "--cover"},
        {cover, "--verbose --min_coverage=100"}
    ]}
]}.
